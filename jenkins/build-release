#!/usr/bin/env groovy

// Build a Zulip production release tarball and publish it to Artifactory
// (dev + prod).
//
// This Jenkinsfile lives in the drc_zulip application repo so that the
// zulip-build-release job can discover it per branch/tag and build the
// checked-out revision in place. The default SCM checkout provides the source,
// so there is no separate clone and no pinned source branch.
//
// TAG_NAME is expected to be provided by the build (e.g. a tag-triggered
// build). The tarball is named after it.

@Library('DRC_Global_Pipeline_Libraries') _

def has_failures = false

pipeline {
  agent {
    kubernetes(
      drc_k8_agent(templates: [
        [name: 'zulip-ci', isDefault: true]
      ])
    )
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '100', artifactNumToKeepStr: '100'))
    ansiColor('xterm')
  }

  environment {
    GITHUB_ACTIONS = true
    VIRTUAL_ENV = "/srv/zulip-py3-venv"
  }

  stages {
    stage('Configure') {
      steps {
        dir("${WORKSPACE}"){
          script {
            sh """#!/bin/bash
              set -euo xtrace
              git config zulip.zulipRemote origin

              ./tools/provision --build-release-tarball-only
            """
          }
        }
      }
    }
    stage('Build') {
      steps {
        dir("${WORKSPACE}"){
          script {
            sh """#!/bin/bash
              set -eu
              git config zulip.zulipRemote origin

              source ./tools/ci/activate-venv

              ./tools/build-release-tarball ${env.TAG_NAME} \
                && mv /tmp/tmp.*/*-${env.TAG_NAME}.tar.gz ./
            """
          }
        }
      }
    }
    stage('Deploy') {
      steps {
        dir("${WORKSPACE}"){
          script {
            uploadToArtifactory([
              repo: 'devops-generic-dev',
              pattern: "./*-${env.TAG_NAME}.tar.gz",
              git_proj: 'zulip',
              arti_url: 'https://artifactory.datarecognitioncorp.com/artifactory',
              isYumRepo: false
            ])
            uploadToArtifactory([
              repo: 'devops-generic-prod',
              pattern: "./*-${env.TAG_NAME}.tar.gz",
              git_proj: 'zulip',
              arti_url: 'https://artifactory.datarecognitioncorp.com/artifactory',
              isYumRepo: false
            ])
          }
        }
      }
    }
  }
}
