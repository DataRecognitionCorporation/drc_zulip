#!/usr/bin/env groovy

// Promote a DRC Zulip image tag from the LE (shared-services) ECR to the prod
// ECR, following the moodle-pls cicd/build/container_promote standard:
//   * runs on the container-runtime agent (ships `crane`);
//   * the tag to promote is chosen from the shared 'ecr-all-repositories'
//     catalog config file (kept current by the ecr-notification sync jobs);
//   * `crane copy` moves the exact multi-arch manifest LE -> prod (no rebuild).

@Library('DRC_Global_Pipeline_Libraries') _

SHARED_SERVICES_LE = "333509430799"
PROD_ACCOUNT = "911870898277"
REGION = "us-east-2"
REPO_NAME = "drc/pas/zulip"

LE_ECR = "${SHARED_SERVICES_LE}.dkr.ecr.${REGION}.amazonaws.com"
PROD_ECR = "${PROD_ACCOUNT}.dkr.ecr.${REGION}.amazonaws.com"

// Matches the repositoryId format written by the ecr-notification
// Jenkinsfile-sync / Jenkinsfile-ecr-push jobs into the shared
// 'ecr-all-repositories' config file: "<repo>@<account>/<region>".
ECR_CATALOG_REPOSITORY_ID = "${REPO_NAME}@${SHARED_SERVICES_LE}/${REGION}"

pipeline {
  agent {
    kubernetes(
      drc_k8_agent(templates: [
        [name: 'container-runtime', isDefault: true],
      ])
    )
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout()
  }

  parameters {
    jsonParam(
      description: "Tag of ${REPO_NAME} in the LE account to promote to prod. Sourced from the shared 'ecr-all-repositories' catalog (kept up to date by the ecr-notification Jenkinsfile-sync/Jenkinsfile-ecr-push jobs). If a needed tag is missing, run 'Jenkinsfile-sync' first.",
      name: 'IMAGE_TAG',
      query: "\$.repositories[?(@.repositoryId == \"${ECR_CATALOG_REPOSITORY_ID}\")].tags[*]",
      source: configFileSource('ecr-all-repositories')
    )
  }

  stages {
    stage('Promote Image') {
      steps {
        script {
          withEnv([
            "LE_ECR=${LE_ECR}",
            "PROD_ECR=${PROD_ECR}",
            "SOURCE_IMAGE=${LE_ECR}/${REPO_NAME}:${params.IMAGE_TAG}",
            "DESTINATION_IMAGE=${PROD_ECR}/${REPO_NAME}:${params.IMAGE_TAG}",
          ]) {
            drc_assumeRole(accountNumber: SHARED_SERVICES_LE, region: REGION) {
              sh(label: 'Login to LE ECR', script: '''#!/bin/bash
                aws ecr get-login-password | crane auth login --username AWS --password-stdin ${LE_ECR} > /dev/null 2>&1
              ''')
            }

            drc_assumeRole(accountNumber: PROD_ACCOUNT, region: REGION) {
              sh(label: 'Login to prod ECR', script: '''#!/bin/bash
                aws ecr get-login-password | crane auth login --username AWS --password-stdin ${PROD_ECR} > /dev/null 2>&1
              ''')
            }

            sh(label: 'Promote image', script: '''#!/bin/bash
              crane copy ${SOURCE_IMAGE} ${DESTINATION_IMAGE}
            ''')
          }
        }
      }
    }
  }

  post {
    always {
      drc_sendTeamsNotification(
        title: "Promotion of ${REPO_NAME}:${params.IMAGE_TAG} to prod finished with status ${currentBuild.currentResult}",
        message: "Promotion finished with ${currentBuild.currentResult}",
        facts: [
          [name: 'Image Tag', value: "${params.IMAGE_TAG}"],
          [name: 'Source', value: "${LE_ECR}/${REPO_NAME}"],
          [name: 'Destination', value: "${PROD_ECR}/${REPO_NAME}"]
        ]
      )
    }
  }
} // pipeline
