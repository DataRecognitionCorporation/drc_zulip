#!/usr/bin/env groovy

// Build the DRC Zulip container image and push it to the LE (shared-services)
// ECR, following the moodle-pls cicd/build/container_build standard:
//   * a matrix builds each architecture on a NATIVE node (Zulip's provision
//     compiles native deps, so cross-emulation is not viable), pushing a
//     per-arch SHA-pinned tag via `make ci/build` (buildx --push --sbom);
//   * a Push Manifest stage stitches the per-arch tags into multi-arch
//     manifests under the shared tag set.
//
// This produces the image the Zulip Helm chart deploys. Promotion to prod is a
// separate pipeline (container_promote), mirroring moodle-pls.

@Library('DRC_Global_Pipeline_Libraries') _

SHARED_SERVICES_LE = "333509430799"
REGION = "us-east-2"
DEV_ECR = "${SHARED_SERVICES_LE}.dkr.ecr.${REGION}.amazonaws.com"
REPO_NAME = "drc/pas/zulip"

WORKING_DIR = "docker"

// Version label baked into the image; matches version.py / docker/Makefile.
ZULIP_VERSION = "9.2-drc"

pipeline {
  options {
    buildDiscarder(logRotator(numToKeepStr: '4', artifactNumToKeepStr: '4'))
    ansiColor('xterm')
  }
  agent {
    kubernetes(
      drc_k8_agent(templates: [
        [name: 'dind', isDefault: true, config: [cpu: 1, memory: '2Gi']]
      ])
    )
  }

  stages {
    stage('Configure') {
      steps {
        script {
          // Derive the SHAs here rather than in environment{} -- deriving one
          // env var from another (SHORT_SHA from env.GIT_SHA) is evaluated
          // eagerly and fails if GIT_COMMIT is not yet resolvable, which then
          // cascades into the post block ("No such property: GIT_SHA").
          env.GIT_SHA = env.GIT_COMMIT
          env.SHORT_SHA = env.GIT_COMMIT.take(7)
          echo "GIT_SHA=${env.GIT_SHA} SHORT_SHA=${env.SHORT_SHA}"

          // Resolve the Teams webhook non-fatally. Binding it in environment{}
          // as credentials('teams-webhook') aborts the ENTIRE pipeline before
          // any stage runs if that credential is not available to this folder
          // (which is what happened on builds #2/#3: "ERROR: teams-webhook").
          // The notification is best-effort, so a missing credential must not
          // fail the build -- drc_sendTeamsNotification no-ops without a URL.
          try {
            withCredentials([string(credentialsId: 'teams-webhook', variable: 'WH')]) {
              env.TEAMS_WEBHOOK_URL = WH
            }
          } catch (ignored) {
            echo "WARNING: 'teams-webhook' credential not available; Teams notifications disabled for this build."
          }
        }
      }
    }

    stage('Build') {
      matrix {
        agent {
          kubernetes(
            drc_k8_agent(armProcessor: ARCHITECTURE == 'arm64' ? true : false, templates: [
              [name: 'dind', isDefault: true, config: [cpu: 4, memory: '8Gi']]
            ])
          )
        }
        axes {
          axis {
            name 'ARCHITECTURE'
            values 'amd64', 'arm64'
          }
        }
        stages {
          stage('Install Packages') {
            steps {
              script {
                sh 'apk add --upgrade make bind-tools jq bash curl aws-cli'
              }
            }
          }
          stage('Build and Push Container') {
            steps {
              dir("${WORKSPACE}/${WORKING_DIR}") {
                drc_assumeRole(accountNumber: SHARED_SERVICES_LE, region: REGION) {
                  sh "aws ecr get-login-password --region ${REGION} | docker login --username AWS --password-stdin ${DEV_ECR}"
                  sh "docker buildx create --name mybuilder --driver docker-container --use"
                  sh "make ci/build ECR=${DEV_ECR} ZULIP_VERSION=${ZULIP_VERSION} ARCH=${ARCHITECTURE} SHORT_SHA=${env.SHORT_SHA}"
                }
              }
            }
          }
        }
      } // matrix
    } // stage

    stage('Push Manifest') {
      steps {
        dir("${WORKSPACE}/${WORKING_DIR}") {
          script {
            drc_assumeRole(accountNumber: SHARED_SERVICES_LE, region: REGION) {
              sh 'apk add --upgrade aws-cli'
              sh "aws ecr get-login-password --region ${REGION} | docker login --username AWS --password-stdin ${DEV_ECR}"

              def tagList = ["${env.GIT_SHA}", "${env.SHORT_SHA}", "${ZULIP_VERSION}-${env.SHORT_SHA}", "latest"]

              for (String tag in tagList) {
                sh """
                  docker buildx imagetools create -t ${DEV_ECR}/${REPO_NAME}:${tag} \
                    "${DEV_ECR}/${REPO_NAME}:${ZULIP_VERSION}-amd64-${env.SHORT_SHA}" \
                    "${DEV_ECR}/${REPO_NAME}:${ZULIP_VERSION}-arm64-${env.SHORT_SHA}"
                """
              }
            }
          }
        }
      }
    }
  } // stages

  post {
    always {
      script {
        // drc_sendTeamsNotification errors hard if TEAMS_WEBHOOK_URL is unset
        // (the 'teams-webhook' credential is not available to this folder), so
        // only notify when the webhook was resolved in the Configure stage.
        if (env.TEAMS_WEBHOOK_URL?.trim()) {
          drc_sendTeamsNotification(
            title: "Build for ${REPO_NAME} ${ZULIP_VERSION} finished with status ${currentBuild.currentResult}",
            message: "Build finished with ${currentBuild.currentResult}",
            facts: [
              [name: 'Build Status', value: currentBuild.currentResult],
              [name: 'Git SHA', value: "${env.GIT_SHA}"],
              [name: 'Short SHA', value: "${env.SHORT_SHA}"],
              [name: 'Architecture', value: "amd64, arm64"],
              [name: 'ECR Repository', value: "${DEV_ECR}/${REPO_NAME}"]
            ]
          )
        } else {
          echo "Skipping Teams notification: TEAMS_WEBHOOK_URL not set."
        }
      }
    }
  }
} // pipeline
